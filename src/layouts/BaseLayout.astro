---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  tags?: string[];
  noindex?: boolean;
  bodyClass?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, article, published, updated, tags, noindex, bodyClass, jsonLd } =
  Astro.props;

const siteJsonLd = jsonLd ?? {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: SITE.title,
  description: SITE.description,
  url: SITE.url,
  inLanguage: "ru-RU",
  author: { "@type": "Person", name: SITE.author },
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      published={published}
      updated={updated}
      tags={tags}
      noindex={noindex}
      jsonLd={siteJsonLd}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">К содержимому</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
