---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="404" description="Карточка не найдена." noindex>
  <div class="wrap notfound">
    <div class="notfound__card">
      <span class="notfound__stamp" aria-hidden="true">404</span>
      <p class="page-head__kicker"><b>картотека</b> / карточка отсутствует</p>
      <h1 class="notfound__title">Такой карточки<br />нет в ящике.</h1>
      <p class="notfound__text">
        Возможно, шифр изменился, ссылка устарела или карточку ещё не завели.
        Начните с каталога — там все концепты и их направления.
      </p>
      <div class="notfound__actions">
        <a href="/" class="btn btn--primary">Открыть каталог <Icon name="arrowRight" size={16} /></a>
        <a href="/atlas" class="btn">Атлас связей</a>
        <a href="/search" class="btn btn--ghost">Поиск</a>
      </div>
    </div>
  </div>
</BaseLayout>
