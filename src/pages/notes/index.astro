---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import { getCollection } from "astro:content";
import { groupByYear, plural, sortByDate } from "../../lib/utils";

const posts = sortByDate(await getCollection("posts", ({ data }) => !data.draft));
const years = groupByYear(posts);

const filters = [
  { key: "all", label: "всё" },
  { key: "recipe", label: "рецепты" },
  { key: "guide", label: "гайды" },
  { key: "note", label: "заметки" },
];
---

<BaseLayout
  title="Архив"
  description="Все карточки native/ по датам: рецепты, гайды и заметки. Фильтр по формату."
>
  <header class="page-head">
    <div class="wrap">
      <p class="page-head__kicker"><b>картотека</b> / архив</p>
      <h1 class="page-head__title">Архив<br /><span class="thin">по датам.</span></h1>
      <p class="page-head__lead">
        Хронология — не главный вход в картотеку. Но иногда нужно вспомнить,
        что вышло в ноябре. Для смысловых связей есть <a href="/atlas">атлас</a>
        и <a href="/">каталог</a>.
      </p>
      <div class="page-head__meta">
        <span><b>{String(posts.length).padStart(2, "0")}</b> карточек</span>
        <span><b>{String(years.length).padStart(2, "0")}</b> года</span>
      </div>
    </div>
  </header>

  <div class="wrap section">
    <div class="filters" role="group" aria-label="Фильтр по формату">
      {filters.map((filter, index) => (
        <button
          class="filter"
          type="button"
          data-filter={filter.key}
          aria-pressed={index === 0 ? "true" : "false"}
        >{filter.label}</button>
      ))}
      <span class="mono" style="margin-left:auto; font-size:10px; letter-spacing:.05em; text-transform:uppercase; color:var(--muted);" id="filter-count">
        {posts.length} {plural(posts.length, ["карточка", "карточки", "карточек"])}
      </span>
    </div>

    <div id="archive">
      {years.map(({ year, posts: yearPosts }) => (
        <section data-year={String(year)}>
          <div class="year-head"><span>{year}</span></div>
          <div class="concept-grid">
            {yearPosts.map((post) => <ConceptCard post={post} />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("#archive .concept-card")];
  const sections = [...document.querySelectorAll<HTMLElement>("#archive section")];
  const countEl = document.getElementById("filter-count");

  function plural(n: number, forms: [string, string, string]) {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return forms[0];
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return forms[1];
    return forms[2];
  }

  function apply(filter: string) {
    buttons.forEach((button) =>
      button.setAttribute("aria-pressed", String(button.dataset.filter === filter)),
    );

    let visible = 0;
    cards.forEach((card) => {
      const show = filter === "all" || card.dataset.format === filter;
      card.hidden = !show;
      if (show) visible += 1;
    });

    sections.forEach((section) => {
      section.hidden = ![...section.querySelectorAll<HTMLElement>(".concept-card")].some(
        (card) => !card.hidden,
      );
    });

    if (countEl) {
      countEl.textContent = `${visible} ${plural(visible, ["карточка", "карточки", "карточек"])}`;
    }

    const url = new URL(location.href);
    if (filter === "all") url.searchParams.delete("type");
    else url.searchParams.set("type", filter);
    history.replaceState(null, "", url);
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => apply(button.dataset.filter ?? "all"));
  });

  const initial = new URL(location.href).searchParams.get("type");
  if (initial && ["recipe", "guide", "note"].includes(initial)) apply(initial);
</script>
