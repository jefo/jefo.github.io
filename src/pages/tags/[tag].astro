---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getCollection } from "astro:content";
import { allTags, plural, sortByDate, type Post } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = allTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { posts: sortByDate(posts.filter((p) => p.data.tags.includes(tag))) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout
  title={`#${tag}`}
  description={`Материалы по теме ${tag}: рецепты, гайды и заметки для ИИ-нативных инженеров.`}
>
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs mb-6" aria-label="Хлебные крошки">
        <a href="/tags">темы</a><span>/</span><span aria-current="page">{tag}</span>
      </nav>
      <h1 class="page-head__title">#{tag}</h1>
      <p class="page-head__lead">
        {posts.length} {plural(posts.length, ["материал", "материала", "материалов"])}{" "}
        по этому тегу.
      </p>
    </div>
  </header>

  <div class="wrap section">
    <div class="post-list">
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </div>

  <div class="wrap pb-6">
    <a href="/tags" class="btn">← Все темы</a>
  </div>
</BaseLayout>
