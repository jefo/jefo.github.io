---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { allTags, plural, sortByDate, tagColor } from "../../lib/utils";

const posts = sortByDate(await getCollection("posts", ({ data }) => !data.draft));
const tags = allTags(posts);
---

<BaseLayout
  title="Темы"
  description="Все темы картотеки native/: контекст, агенты, MCP, промпты, инструменты и локальные модели."
>
  <header class="page-head">
    <div class="wrap">
      <p class="page-head__kicker"><b>картотека</b> / темы</p>
      <h1 class="page-head__title">Темы<br /><span class="thin">и срезы.</span></h1>
      <p class="page-head__lead">
        Теги — это не рубрики, а срезы. Один концепт может быть про контекст,
        агентов и стоимость одновременно. Для структуры есть направления,
        для связей — атлас.
      </p>
      <div class="page-head__meta">
        <span><b>{String(tags.length).padStart(2, "0")}</b> {plural(tags.length, ["тема", "темы", "тем"])}</span>
        <span><b>{String(posts.length).padStart(2, "0")}</b> карточек</span>
      </div>
    </div>
  </header>

  <div class="wrap section">
    <div class="tag-grid">
      {tags.map(({ tag, count }) => (
        <a href={`/tags/${tag}`} class="tag-slip" style={`--tag-color: ${tagColor(tag)};`}>
          <span class="tag-slip__name">{tag}</span>
          <span class="tag-slip__count">{String(count).padStart(2, "0")} →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
