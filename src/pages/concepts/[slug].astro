---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { FORMAT_META, KIND_META, LEVEL_META, SITE, isPlaceholderLink } from "../../config";
import {
  conceptCode,
  conceptNeighbours,
  connections,
  formatDate,
  postDomains,
  postHref,
  postMinutes,
  primaryDomain,
  routesForPost,
  sortedConcepts,
  tagColor,
} from "../../lib/utils";
import { DOMAIN_BY_ID } from "../../data/hub";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const format = FORMAT_META[post.data.format];
const kind = KIND_META[post.data.kind];
const all = sortedConcepts(await getCollection("posts", ({ data }) => !data.draft));
const domain = primaryDomain(post);
const domains = postDomains(post);
const code = conceptCode(post);
const minutes = postMinutes(post);
const level = post.data.level ? LEVEL_META[post.data.level] : undefined;
const related = connections(post, all, 3);
const routes = routesForPost(post.data.uid);
const { previous, next } = conceptNeighbours(post, all);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const updated = post.data.updated ?? post.data.date;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: updated.toISOString(),
  inLanguage: "ru-RU",
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  publisher: { "@type": "Organization", name: "native/" },
  mainEntityOfPage: new URL(postHref(post), SITE.url).href,
  articleSection: domains.map((item) => item.name),
  keywords: post.data.tags.join(", "),
  timeRequired: `PT${minutes.replace(/\D/g, "")}M`,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article
  published={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <article>
    <header class="concept-head" style={`--domain-color: ${domain.color};`}>
      <div class="wrap concept-head__grid">
        <div class="concept-head__main">
          <span class="concept-head__ghost" aria-hidden="true">{code}</span>
          <nav class="crumbs" aria-label="Хлебные крошки">
            <a href="/">картотека</a><span>/</span>
            <a href={`/domains/${domain.id}`}>{domain.name}</a><span>/</span>
            <span aria-current="page">{code}</span>
          </nav>

          <div class="concept-head__domains">
            {domains.map((item) => (
              <a
                href={`/domains/${item.id}`}
                class="dom-pill"
                style={`--domain-color: ${item.color};`}
              >{item.name}</a>
            ))}
          </div>

          <h1 class="concept-title">{post.data.title}</h1>
          <p class="concept-desc">{post.data.description}</p>

          <div class="concept-meta">
            <span class="concept-meta__code">{code}</span>
            <span>{kind.label}</span>
            <span class="concept-meta__dot" aria-hidden="true"></span>
            <span>{format.label}</span>
            <span class="concept-meta__dot" aria-hidden="true"></span>
            <span>{formatDate(post.data.date)}</span>
            <span class="concept-meta__dot" aria-hidden="true"></span>
            <span>{minutes} чтения</span>
            {level && (
              <>
                <span class="concept-meta__dot" aria-hidden="true"></span>
                <span>{level.label}</span>
              </>
            )}
            <span class="concept-meta__dot" aria-hidden="true"></span>
            <span>обновлено {formatDate(updated)}</span>
          </div>

          {post.data.tags.length > 0 && (
            <div class="post-tags" style="display:flex; flex-wrap:wrap; gap:6px; margin-top:16px;">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}`} class="tag" style={`--tag-color: ${tagColor(tag)};`}>{tag}</a>
              ))}
            </div>
          )}
        </div>

        <aside class="library-card" aria-label="Карточка концепта">
          <p class="library-card__kicker">native/ · карточка концепта</p>
          <dl class="library-card__fields">
            <div><dt>шифр</dt><dd>{code}</dd></div>
            <div><dt>тип</dt><dd>{kind.label}</dd></div>
            <div><dt>формат</dt><dd>{format.label}</dd></div>
            <div><dt>раздел</dt><dd>{domains.map((item) => item.name).join(" / ")}</dd></div>
            <div><dt>уровень</dt><dd>{level?.label ?? "любой"}</dd></div>
            <div><dt>время</dt><dd>{minutes}</dd></div>
            <div><dt>обновлено</dt><dd>{formatDate(updated)}</dd></div>
            {post.data.tools?.length ? (
              <div><dt>стек</dt><dd>{post.data.tools.join(", ")}</dd></div>
            ) : null}
          </dl>
          <div class="library-card__barcode" aria-hidden="true"></div>
          <p class="library-card__note">картотека · {DOMAIN_BY_ID[domain.id].index} / {code}</p>
        </aside>
      </div>
    </header>

    <div class="wrap concept-layout">
      <div class="concept-main">
        {toc.length > 1 && (
          <details class="toc-mobile">
            <summary>На этой карточке</summary>
            <ol>
              {toc.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </details>
        )}

        <div class="prose" id="article">
          <Content />
        </div>

        <p class="signoff">— native/ <span>{code} · обновлено {formatDate(updated)}</span></p>

        <section class="connections">
          <div class="connections__head">
            <h2 class="connections__title">Связи</h2>
            <a href="/atlas" class="sec-link">Весь атлас <span aria-hidden="true">→</span></a>
          </div>
          <div class="connections__grid">
            {related.map(({ post: relatedPost, sharedTags }) => (
              <a href={postHref(relatedPost)} class="link-card">
                <span class="link-card__code">{conceptCode(relatedPost)} · {primaryDomain(relatedPost).name}</span>
                <span class="link-card__title">{relatedPost.data.title}</span>
                <span class="link-card__meta">
                  {sharedTags.length} {sharedTags.length === 1 ? "общая тема" : "общих тем"}: {sharedTags.slice(0, 3).join(", ")}
                </span>
              </a>
            ))}
          </div>
        </section>

        <footer class="concept-foot">
          <div class="concept-actions">
            <button class="btn btn--ghost" type="button" data-copy-link>
              <Icon name="link" size={15} /> Скопировать ссылку
            </button>
            {!isPlaceholderLink(SITE.chat) && (
              <a href={SITE.chat} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">
                <Icon name="telegram" size={15} /> Обсудить
              </a>
            )}
            <a href="/atlas" class="btn btn--ghost"><Icon name="map" size={15} /> Атлас</a>
          </div>

          <div class="pagination">
            {previous ? (
              <a href={postHref(previous)} class="pagination__item">
                <span class="pagination__k">← {conceptCode(previous)}</span>
                <span class="pagination__t">{previous.data.title}</span>
              </a>
            ) : (
              <div class="pagination__item"></div>
            )}
            {next ? (
              <a href={postHref(next)} class="pagination__item pagination__item--next">
                <span class="pagination__k">{conceptCode(next)} →</span>
                <span class="pagination__t">{next.data.title}</span>
              </a>
            ) : (
              <div class="pagination__item"></div>
            )}
          </div>
        </footer>
      </div>

      <aside class="concept-aside" aria-label="Навигация по карточке">
        <div class="aside-sticky">
          {toc.length > 1 && (
            <nav class="toc">
              <p class="toc__title">На этой карточке</p>
              <ul class="toc__list">
                {toc.map((heading) => (
                  <li class={heading.depth === 3 ? "toc--sub" : ""}>
                    <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {routes.length > 0 && (
            <div class="aside-block">
              <p class="aside-block__k">в маршрутах</p>
              {routes.map((route) => (
                <a href={`/paths/${route.slug}`} class="aside-link">
                  <span>{route.title}</span>
                  <code>{route.code}</code>
                </a>
              ))}
            </div>
          )}

          <div class="aside-block">
            <p class="aside-block__k">соседи</p>
            <a href="/" class="aside-link">
              <span>Каталог концептов</span>
              <code>↗</code>
            </a>
            <a href="/atlas" class="aside-link">
              <span>Атлас связей</span>
              <code>↗</code>
            </a>
            <a href={`/domains/${domain.id}`} class="aside-link">
              <span>Направление «{domain.name}»</span>
              <code>↗</code>
            </a>
          </div>

          <div class="save-card">
            <p class="save-card__title">В закладки</p>
            <p class="save-card__text">
              <kbd>Ctrl</kbd> + <kbd>D</kbd> на компьютере или «Поделиться → В закладки»
              на телефоне.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <div class="toast" id="toast" role="status" aria-live="polite">Ссылка скопирована</div>
</BaseLayout>

<script>
  // прогресс чтения
  const bar = document.getElementById("progress");
  const article = document.getElementById("article");
  if (bar && article) {
    let raf = 0;
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight + 240;
      const passed = -rect.top + 120;
      const value = Math.min(1, Math.max(0, passed / Math.max(total, 1)));
      bar.style.transform = `scaleX(${value})`;
    };
    window.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // оглавление: подсветка активного пункта
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  if (tocLinks.length) {
    const byId = new Map(tocLinks.map((link) => [link.hash.slice(1), link]));
    const targets = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (id: string) => {
      tocLinks.forEach((link) => link.removeAttribute("data-active"));
      byId.get(id)?.setAttribute("data-active", "true");
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-88px 0px -68% 0px", threshold: [0, 1] },
    );
    targets.forEach((target) => observer.observe(target));
    if (targets[0]) setActive(targets[0].id);
  }

  // оформление код-блоков: шапка + копирование + anchor-ссылки
  document.querySelectorAll<HTMLPreElement>(".prose pre.astro-code").forEach((pre) => {
    const lang =
      pre.dataset.language ??
      [...pre.classList].find((className) => className.startsWith("language-"))?.replace("language-", "") ??
      "code";

    const shell = document.createElement("div");
    shell.className = "code-shell";

    const bar = document.createElement("div");
    bar.className = "code-bar";

    const label = document.createElement("span");
    label.className = "code-bar__lang";
    label.textContent = lang;

    const copy = document.createElement("button");
    copy.type = "button";
    copy.className = "code-bar__copy";
    copy.textContent = "copy";
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        copy.textContent = "copied";
        copy.dataset.copied = "true";
        setTimeout(() => {
          copy.textContent = "copy";
          delete copy.dataset.copied;
        }, 1600);
      } catch {
        copy.textContent = "ctrl+c";
      }
    });

    bar.append(label, copy);
    pre.replaceWith(shell);
    shell.append(bar, pre);
  });

  document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]").forEach((heading) => {
    const anchor = document.createElement("a");
    anchor.className = "heading-anchor";
    anchor.href = `#${heading.id}`;
    anchor.textContent = "#";
    anchor.setAttribute("aria-label", "Ссылка на раздел");
    heading.append(anchor);
  });

  // копировать ссылку
  const toast = document.getElementById("toast");
  document.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        if (toast) {
          toast.dataset.show = "true";
          setTimeout(() => delete toast.dataset.show, 1800);
        }
      } catch {
        /* noop */
      }
    });
  });
</script>
