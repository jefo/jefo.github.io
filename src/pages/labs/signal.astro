---
import LabLayout from "../../layouts/LabLayout.astro";
import "../../styles/labs/signal.css";

const domains = [
  { id: "context", index: "01", name: "Контекст", tagline: "диффузия внимания", count: 4 },
  { id: "agents", index: "02", name: "Агенты", tagline: "петли и границы", count: 4 },
  { id: "tools", index: "03", name: "Инструменты", tagline: "анизотропный слой", count: 4 },
  { id: "practice", index: "04", name: "Практика", tagline: "зерно применения", count: 4 },
];

const nodes = [
  { id: "K-01", x: 158, y: 165, color: "#7fe7d4", label: "Бюджет контекста" },
  { id: "K-02", x: 300, y: 105, color: "#7fe7d4", label: "40-й шаг" },
  { id: "K-03", x: 170, y: 300, color: "#7fe7d4", label: "Tool Search" },
  { id: "K-04", x: 320, y: 345, color: "#7fe7d4", label: "TS: рецепт" },
  { id: "A-01", x: 520, y: 140, color: "#b79cff", label: "CLAUDE.md" },
  { id: "A-02", x: 620, y: 280, color: "#b79cff", label: "Spec-driven" },
  { id: "A-03", x: 770, y: 160, color: "#ffb35c", label: "MCP за 20 минут" },
  { id: "T-01", x: 860, y: 330, color: "#ffb35c", label: "Локальная модель" },
  { id: "P-01", x: 590, y: 430, color: "#c7ff4f", label: "Критик" },
];

const edges: [string, string][] = [
  ["K-01", "K-02"],
  ["K-01", "K-03"],
  ["K-01", "K-04"],
  ["K-01", "A-01"],
  ["K-01", "P-01"],
  ["K-02", "A-01"],
  ["K-02", "A-03"],
  ["K-02", "A-02"],
  ["K-03", "K-04"],
  ["K-03", "A-01"],
  ["K-03", "A-03"],
  ["K-03", "T-01"],
  ["K-04", "A-03"],
  ["K-04", "T-01"],
  ["A-01", "A-02"],
  ["A-03", "A-02"],
  ["A-03", "T-01"],
  ["A-02", "P-01"],
];

const byId = new Map(nodes.map((node) => [node.id, node]));
---

<LabLayout title="Signal" variant="signal" description="Signal — стекло, свет, абстрактные поля и топология данных.">
  <main class="sg-page">
    <header class="sg-nav">
      <a href="/" class="sg-brand">native<b>/</b><i aria-hidden="true"></i></a>
      <nav aria-label="Навигация варианта">
        <a href="#domains">Направления</a>
        <a href="#concept">Карточка</a>
        <a href="#atlas">Атлас</a>
        <a href="#tokens">Токены</a>
      </nav>
      <span class="sg-nav__meta">signal / 09 · 04 · 25</span>
    </header>

    <section class="sg-hero">
      <div>
        <p class="sg-kicker"><b>signal</b> · картотека знаний</p>
        <h1><span class="sg-title-line">Знание не в ленте.</span><span class="sg-title-line">Оно в <em>картотеке</em>.</span></h1>
        <p class="sg-lede">
          Хаб об инженерии ПО с ИИ. Девять концептов, четыре направления,
          связи и маршруты. Текст остаётся текстом, а материал — светом,
          зерном и данными.
        </p>
        <div class="sg-actions">
          <a href="#domains" class="sg-btn sg-btn--primary">Открыть каталог →</a>
          <a href="#atlas" class="sg-btn sg-btn--glass">Смотреть атлас</a>
        </div>
        <div class="sg-stats">
          <span class="sg-stat"><b>09</b>концептов</span>
          <span class="sg-stat"><b>04</b>направления</span>
          <span class="sg-stat"><b>25</b>связей</span>
          <span class="sg-stat"><b>03</b>маршрута</span>
        </div>
      </div>

      <div class="sg-field" aria-hidden="true">
        <div class="sg-field__glow"></div>
        <span class="sg-ring sg-ring--a"></span>
        <span class="sg-ring sg-ring--b"></span>
        <span class="sg-ring sg-ring--c"></span>
        <i class="sg-node sg-node--1"></i>
        <i class="sg-node sg-node--2"></i>
        <i class="sg-node sg-node--3"></i>
        <i class="sg-node sg-node--4"></i>
        <i class="sg-node sg-node--5"></i>
        <div class="sg-glass-card">
          <div class="sg-glass-card__top"><span>K-01</span><span>контекст</span></div>
          <p class="sg-glass-card__title">Бюджет контекста</p>
          <p class="sg-glass-card__meta">6 мин · легко · 4 связи</p>
          <div class="sg-signal"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
      </div>
    </section>

    <section class="sg-section" id="domains">
      <header class="sg-sec-head">
        <div class="sg-sec-head__left">
          <span class="sg-sec-head__index">01</span>
          <h2>Четыре сигнала.</h2>
        </div>
        <p>Направления — не карточки материала, а абстрактные поля. Форма несёт смысл, но не изображает предмет.</p>
        <a href="#" class="sg-link">Весь каталог →</a>
      </header>

      <div class="sg-domains">
        {domains.map((domain) => (
          <a href="#" class={`sg-domain sg-domain--${domain.id}`}>
            <div class="sg-domain__field" aria-hidden="true"></div>
            <div class="sg-domain__body">
              <span class="sg-domain__index">{domain.index} / 04</span>
              <h3>{domain.name}</h3>
              <p>{domain.tagline}</p>
              <div class="sg-domain__foot">
                <span>{String(domain.count).padStart(2, "0")} концепта</span>
                <span aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="sg-section sg-split" id="concept">
      <article class="sg-concept">
        <span class="sg-concept__code">K-01 · КОНТЕКСТ · РЕЦЕПТ</span>
        <h3>Контекстное окно — это бюджет, а не склад</h3>
        <p>
          Пять правил упаковки контекста: что класть в окно, что выкидывать
          без жалости и как понять, что вы уже утонули. Модель внимательнее
          к началу и концу — середина окна проваливается первой.
        </p>
        <div class="sg-concept__meta">
          <span>6 мин</span>
          <span>легко</span>
          <span>4 связи</span>
          <span>маршрут R-01</span>
        </div>
        <div class="sg-concept__links">
          <a href="#">Открыть карточку →</a>
          <a href="#">Связи</a>
          <a href="#">В атласе</a>
        </div>
      </article>

      <aside class="sg-route">
        <div class="sg-route__head"><span>R-01 · маршрут</span><span>2 / 5</span></div>
        <h3>Первый контакт</h3>
        <div class="sg-route__bar"><i style="width: 40%"></i></div>
        <ol class="sg-route__steps">
          <li data-done><i>01</i><span>CLAUDE.md</span><b>✓</b></li>
          <li data-done><i>02</i><span>Бюджет контекста</span><b>✓</b></li>
          <li><i>03</i><span>Spec-driven</span><b>→</b></li>
          <li><i>04</i><span>MCP за 20 минут</span><b>→</b></li>
          <li><i>05</i><span>40-й шаг</span><b>→</b></li>
        </ol>
      </aside>
    </section>

    <section class="sg-section" id="atlas">
      <header class="sg-sec-head">
        <div class="sg-sec-head__left">
          <span class="sg-sec-head__index">02</span>
          <h2>Топология, не созвездие.</h2>
        </div>
        <p>Узлы — концепты, линии — общие темы. Фон — поле, а не декоративная карта.</p>
      </header>

      <div class="sg-atlas">
        <div class="sg-atlas__bar">
          <span><b>ATLAS</b> / 25 связей</span>
          <div class="sg-atlas__chips">
            <span>все</span><span>контекст</span><span>агенты</span><span>инструменты</span><span>практика</span>
          </div>
        </div>

        <svg viewBox="0 0 1000 520" role="img" aria-label="Абстрактная топология концептов">
          <g>
            {edges.map(([a, b]) => {
              const from = byId.get(a)!;
              const to = byId.get(b)!;
              return <line x1={from.x} y1={from.y} x2={to.x} y2={to.y} class="sg-edge" />;
            })}
          </g>
          <g>
            {nodes.map((node) => (
              <g>
                <circle cx={node.x} cy={node.y} r="16" fill={node.color} opacity="0.16" />
                <circle cx={node.x} cy={node.y} r="6" fill={node.color} />
                <text x={node.x} y={node.y + 26} text-anchor="middle" class="sg-node-code">{node.id}</text>
                <text x={node.x} y={node.y + 39} text-anchor="middle" class="sg-node-label">{node.label}</text>
              </g>
            ))}
          </g>
        </svg>

        <div class="sg-atlas__card">
          <span>K-01 · КОНТЕКСТ</span>
          <h3>Контекстное окно — это бюджет</h3>
          <p>4 связи · 2 маршрута · 6 мин чтения</p>
        </div>
      </div>
    </section>

    <section class="sg-tokens" id="tokens">
      <div class="sg-tokens__block">
        <p>палитра / surface</p>
        <div class="sg-swatches">
          <span class="sg-swatch" style="background:#080a09"></span>
          <span class="sg-swatch" style="background:#c7ff4f"></span>
          <span class="sg-swatch" style="background:#7fe7d4"></span>
          <span class="sg-swatch" style="background:#b79cff"></span>
          <span class="sg-swatch" style="background:#ffb35c"></span>
          <span class="sg-swatch" style="background:rgba(255,255,255,.08)"></span>
        </div>
      </div>
      <div class="sg-tokens__block">
        <p>типографика / ритм</p>
        <div class="sg-type">
          <div><b>Literata</b><span>чтение / заголовки</span></div>
          <div><b style="font-family: var(--font-sans); font-size: 20px;">Inter Tight</b><span>интерфейс</span></div>
          <div><b style="font-family: var(--font-mono); font-size: 14px; letter-spacing: .06em;">JETBRAINS MONO</b><span>шифры / метки</span></div>
        </div>
      </div>
    </section>
  </main>
</LabLayout>
