---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE, isPlaceholderLink } from "../config";

const facts = [
  { k: "Роль", v: "full-stack-разработчик" },
  { k: "Опыт", v: "15 лет" },
  { k: "Стек", v: "TypeScript, Node, Postgres" },
];

const links = [
  { label: "YouTube", href: SITE.socials.youtube, icon: "youtube" as const },
  { label: "Telegram", href: SITE.socials.telegram, icon: "telegram" as const },
  { label: "GitHub", href: SITE.socials.github, icon: "github" as const },
  { label: "X / Twitter", href: SITE.socials.x, icon: "x" as const },
].filter((l) => !isPlaceholderLink(l.href));

const emailConfigured = !SITE.email.includes("native.blog");

const aboutDescription = `native/ — журнал об инженерии ПО в эпоху супер-интеллекта. Миссия — ${SITE.mission}. Автор — ${SITE.author}.`;
---

<BaseLayout
  title="О журнале"
  description={aboutDescription}
>
  <header class="page-head">
    <div class="wrap">
      <h1 class="page-head__title">Инженерия<br />в эпоху супер-интеллекта.</h1>
      <p class="page-head__lead">
        native/ — независимый журнал о том, как строить софт вместе с ИИ. Миссия —
        {SITE.mission}: для инженеров и для всех, кто хочет перенять инженерное мышление.
      </p>
    </div>
  </header>

  <div class="wrap about-grid">
    <div class="prose">
      <p>
        <strong>Миссия.</strong> ИИ-грамотность — это не умение писать промпты. Это
        понимание, как устроены инструменты, где они ломаются и как проверить результат.
        Журнал переводит это на язык практики.
      </p>
      <p>
        native/ — журнал, а не личный дневник. Обложка принадлежит журналу, автор — его
        голос.
      </p>

      <h2>Что здесь есть</h2>
      <p>
        Полные версии шортсов: рецепты, гайды и заметки. С кодом, ограничениями
        и чек-листами. Страницы рассчитаны на возврат через месяц — без «как вы помните,
        в прошлом выпуске».
      </p>
      <p>
        Это <strong>бортжурнал</strong>: что попробовал, что сработало, что сломалось.
        С датами и обновлениями.
      </p>

      <h2>Кто делает</h2>
      <p>
        Автор журнала — <strong>{SITE.author}</strong>, full-stack-разработчик.
        15 лет в деле — и не собирается останавливаться. Делает собственное ПО
        и показывает процесс: как ИИ-инструменты меняют разработку, не заменяя
        инженерное мышление.
      </p>
      <p>
        YouTube-канал — об инженерии ПО в эпоху супер-интеллекта. Он не только для
        инженеров: инженерное мышление можно перенять, даже если вы не пишете код.
      </p>

      <h2>Как устроены материалы</h2>
      <ul>
        <li>В рецепте — код или команды, которые можно применить сразу.</li>
        <li>В гайде — границы: где решение ломается.</li>
        <li>В конце — чек-лист, а не «удачи».</li>
      </ul>
      <p>
        Если нашли ошибку — напишите: исправлю и допишу в грабли.
      </p>
    </div>

    <aside class="about-side">
      <div class="about-card">
        <div class="about-mark" aria-hidden="true">n<span>/</span></div>
        <p class="label">Автор журнала</p>
        <p class="about-author-name">{SITE.author}</p>
        <ul class="about-facts mt-3">
          {facts.map((f) => (
            <li><span>{f.k}</span><b class="font-normal text-[var(--ink)]">{f.v}</b></li>
          ))}
        </ul>
      </div>

      <div class="about-card">
        <p class="label mb-3">Связаться</p>
        <ul class="grid gap-2.5">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="footer__link items-center"
              >
                <Icon name={l.icon} size={15} /> {l.label}
              </a>
            </li>
          ))}
          {emailConfigured && (
            <li>
              <a href={`mailto:${SITE.email}`} class="footer__link items-center">
                <Icon name="link" size={15} /> {SITE.email}
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="about-card">
        <p class="label mb-2">Подписка</p>
        <p class="text-[13px] leading-relaxed text-[var(--ink-2)]">
          Новые материалы — в RSS и Telegram.
        </p>
        <a href="/rss.xml" class="btn btn--ghost mt-3 w-full justify-start px-0">
          <Icon name="rss" size={15} /> RSS
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
