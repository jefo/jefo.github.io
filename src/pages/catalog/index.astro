---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import { getCollection } from "astro:content";
import { DOMAINS, ROUTES } from "../../data/hub";
import { domainCounts, plural, sortedConcepts, type Post } from "../../lib/utils";

const posts = sortedConcepts(await getCollection("posts", ({ data }) => !data.draft));
const counts = domainCounts(posts);

const typeCounts = posts.reduce(
  (acc, post) => ({ ...acc, [post.data.type]: (acc[post.data.type] ?? 0) + 1 }),
  {} as Record<string, number>,
);

const formats = [
  { id: "recipe", label: "Рецепты" },
  { id: "guide", label: "Гайды" },
  { id: "note", label: "Заметки" },
];
---

<BaseLayout
  title="Каталог"
  description="Все концепты картотеки native/: контекст, агенты, инструменты и практика. Фильтр по направлению и формату."
>
  <header class="page-head">
    <div class="wrap">
      <p class="page-head__kicker"><b>картотека</b> / индекс</p>
      <h1 class="page-head__title">Каталог<br /><span class="thin">концептов.</span></h1>
      <p class="page-head__lead">
        {posts.length} {plural(posts.length, ["карточка", "карточки", "карточек"])},
        {" "}{DOMAINS.length} {plural(DOMAINS.length, ["направление", "направления", "направлений"])}
        и пересечения между ними. Один концепт может лежать сразу в нескольких
        направлениях — на карточке видны все.
      </p>
      <div class="page-head__meta">
        <span><b>{String(posts.length).padStart(2, "0")}</b> концептов</span>
        <span><b>{String(DOMAINS.length).padStart(2, "0")}</b> направления</span>
        <span><b>{String(DOMAINS.length).padStart(2, "0")}</b> материала</span>
        <span><b>{String(ROUTES.length).padStart(2, "0")}</b> маршрута</span>
      </div>
    </div>
  </header>

  <div class="wrap catalog">
    <aside class="catalog__side" aria-label="Фильтры каталога">
      <div class="filter-block">
        <p class="filter-block__k">Направление</p>
        <div class="filter-list">
          <button class="filter-tab" type="button" data-filter-domain="all" aria-pressed="true">
            <span class="filter-tab__left"><span class="dom-dot" style="--domain-color: var(--accent-text);"></span>Все</span>
            <span class="filter-tab__count">{String(posts.length).padStart(2, "0")}</span>
          </button>
          {DOMAINS.map((domain) => (
            <button
              class="filter-tab"
              type="button"
              data-filter-domain={domain.id}
              aria-pressed="false"
            >
              <span class="filter-tab__left">
                <span class="dom-dot" style={`--domain-color: ${domain.color};`}></span>
                {domain.name}
              </span>
              <span class="filter-tab__count">{String(counts[domain.id]).padStart(2, "0")}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="filter-block">
        <p class="filter-block__k">Формат</p>
        <div class="filter-list">
          <button class="filter-tab" type="button" data-filter-type="all" aria-pressed="true">
            <span class="filter-tab__left">Любой</span>
            <span class="filter-tab__count">{String(posts.length).padStart(2, "0")}</span>
          </button>
          {formats.map((format) => (
            <button
              class="filter-tab"
              type="button"
              data-filter-type={format.id}
              aria-pressed="false"
            >
              <span class="filter-tab__left">{format.label}</span>
              <span class="filter-tab__count">{String(typeCounts[format.id] ?? 0).padStart(2, "0")}</span>
            </button>
          ))}
        </div>
      </div>

      <p class="catalog__note">
        Концепт показывается один раз, даже если лежит в нескольких направлениях.
        Пересечения видны в карточке и в атласе.
      </p>
    </aside>

    <div class="catalog__main">
      <div class="catalog__bar">
        <span><b id="catalog-count">{String(posts.length).padStart(2, "0")}</b> <span id="catalog-count-label">{plural(posts.length, ["концепт", "концепта", "концептов"])}</span></span>
        <button class="catalog__reset" type="button" id="catalog-reset">Сбросить фильтры</button>
      </div>

      <div class="concept-grid catalog__grid" id="catalog-grid">
        {posts.map((post: Post, index: number) => <ConceptCard post={post} index={index} />)}
      </div>

      <p class="empty-state" id="catalog-empty" hidden>
        Под этот фильтр пока нет карточек. Попробуйте другое направление.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>("#catalog-grid .concept-card")];
  const domainButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter-domain]")];
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter-type]")];
  const countEl = document.getElementById("catalog-count");
  const countLabel = document.getElementById("catalog-count-label");
  const empty = document.getElementById("catalog-empty");
  const reset = document.getElementById("catalog-reset");

  function plural(n: number, forms: [string, string, string]) {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return forms[0];
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return forms[1];
    return forms[2];
  }

  let domain = "all";
  let type = "all";

  function apply(updateUrl = true) {
    let visible = 0;
    cards.forEach((card) => {
      const domains = (card.dataset.domains ?? "").split(" ");
      const show = (domain === "all" || domains.includes(domain)) && (type === "all" || card.dataset.type === type);
      card.hidden = !show;
      if (show) visible += 1;
    });

    domainButtons.forEach((button) =>
      button.setAttribute("aria-pressed", String(button.dataset.filterDomain === domain)),
    );
    typeButtons.forEach((button) =>
      button.setAttribute("aria-pressed", String(button.dataset.filterType === type)),
    );

    if (countEl) countEl.textContent = String(visible).padStart(2, "0");
    if (countLabel) countLabel.textContent = plural(visible, ["концепт", "концепта", "концептов"]);
    if (empty) empty.hidden = visible > 0;

    if (updateUrl) {
      const url = new URL(location.href);
      if (domain === "all") url.searchParams.delete("domain");
      else url.searchParams.set("domain", domain);
      if (type === "all") url.searchParams.delete("type");
      else url.searchParams.set("type", type);
      history.replaceState(null, "", url);
    }
  }

  domainButtons.forEach((button) => {
    button.addEventListener("click", () => {
      domain = button.dataset.filterDomain ?? "all";
      apply();
    });
  });
  typeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      type = button.dataset.filterType ?? "all";
      apply();
    });
  });
  reset?.addEventListener("click", () => {
    domain = "all";
    type = "all";
    apply();
  });

  const params = new URLSearchParams(location.search);
  const initialDomain = params.get("domain");
  const initialType = params.get("type");
  if (initialDomain && domainButtons.some((button) => button.dataset.filterDomain === initialDomain)) {
    domain = initialDomain;
  }
  if (initialType && typeButtons.some((button) => button.dataset.filterType === initialType)) {
    type = initialType;
  }
  apply(false);
</script>
