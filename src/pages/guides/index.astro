---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import { getCollection } from "astro:content";
import { plural, sortedConcepts } from "../../lib/utils";

const posts = sortedConcepts(
  await getCollection("posts", ({ data }) => !data.draft && data.type === "guide"),
);
---

<BaseLayout
  title="Гайды"
  description="Длинные разборы картотеки: процессы, архитектура и инструменты для ИИ-нативной разработки."
>
  <header class="page-head">
    <div class="wrap">
      <p class="page-head__kicker"><b>формат</b> / гайды</p>
      <h1 class="page-head__title">Гайды.</h1>
      <p class="page-head__lead">
        Сквозные процессы и разборы, которые не помещаются в один шаг.
        С примерами, границами и критериями.
      </p>
      <div class="page-head__meta">
        <span><b>{String(posts.length).padStart(2, "0")}</b> {plural(posts.length, ["гайд", "гайда", "гайдов"])}</span>
        <span>в картотеке</span>
      </div>
    </div>
  </header>

  <div class="wrap section">
    <div class="concept-grid">
      {posts.map((post, index) => <ConceptCard post={post} index={index} />)}
    </div>
  </div>
</BaseLayout>
