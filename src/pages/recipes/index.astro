---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import { getCollection } from "astro:content";
import { plural, sortedConcepts } from "../../lib/utils";

const posts = sortedConcepts(
  await getCollection("posts", ({ data }) => !data.draft && data.format === "recipe"),
);
---

<BaseLayout
  title="Рецепты"
  description="Короткие проверенные приёмы картотеки: что скопировать, куда вставить и что пойдёт не так."
>
  <header class="page-head">
    <div class="wrap">
      <p class="page-head__kicker"><b>формат</b> / рецепты</p>
      <h1 class="page-head__title">Рецепты.</h1>
      <p class="page-head__lead">
        Один приём — одна карточка. Код, команды и грабли, чтобы повторить у себя
        и не искать те же ошибки.
      </p>
      <div class="page-head__meta">
        <span><b>{String(posts.length).padStart(2, "0")}</b> {plural(posts.length, ["рецепт", "рецепта", "рецептов"])}</span>
        <span>в картотеке</span>
      </div>
    </div>
  </header>

  <div class="wrap section">
    <div class="concept-grid">
      {posts.map((post, index) => <ConceptCard post={post} index={index} />)}
    </div>
  </div>
</BaseLayout>
