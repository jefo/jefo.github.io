---
import { getCollection } from "astro:content";
import { FORMAT_META } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { type: FORMAT_META[post.data.format].plural, slug: post.id },
    props: { href: `/concepts/${post.id}`, title: post.data.title },
  }));
}

const { href, title } = Astro.props as { href: string; title: string };
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <link rel="canonical" href={href} />
    <title>{title} — native/</title>
  </head>
  <body>
    <p><a href={href}>Перейти к карточке →</a></p>
  </body>
</html>
