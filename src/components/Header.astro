---
import { NAV, SITE } from "../config";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.mark} — на главную`}>
      <span>{SITE.mark}</span><span class="brand__slash" aria-hidden="true"></span>
    </a>

    <nav class="nav nav--desktop" aria-label="Основная навигация">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="nav__link"
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <a href="/search" class="icon-btn" aria-label="Поиск по блогу" title="Поиск (/)">
        <Icon name="search" size={18} />
      </a>
      <a
        href={SITE.socials.youtube}
        class="icon-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="YouTube-канал"
        title="YouTube"
      >
        <Icon name="youtube" size={19} />
      </a>
      <span class="header-tools__divider" aria-hidden="true"></span>
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Переключить тему"
        title="Светлая / тёмная тема"
      >
        <span class="theme-icon theme-icon--sun"><Icon name="sun" size={17} /></span>
        <span class="theme-icon theme-icon--moon"><Icon name="moon" size={17} /></span>
      </button>
      <button
        id="menu-toggle"
        class="icon-btn mobile-toggle"
        type="button"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="menu-icon menu-icon--open"><Icon name="menu" size={20} /></span>
        <span class="menu-icon menu-icon--close"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-open="false">
    {NAV.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
        <span>{item.note}</span>
      </a>
    ))}
  </div>
</header>

<style>
  .theme-icon--sun {
    display: none;
  }
  :global(.dark) .theme-icon--sun {
    display: block;
  }
  :global(.dark) .theme-icon--moon {
    display: none;
  }
  .menu-icon--close {
    display: none;
  }
  #menu-toggle[aria-expanded="true"] .menu-icon--open {
    display: none;
  }
  #menu-toggle[aria-expanded="true"] .menu-icon--close {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById("theme-toggle");

  themeBtn?.addEventListener("click", () => {
    const next = root.classList.contains("dark") ? "light" : "dark";
    root.classList.toggle("dark", next === "dark");
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* noop */
    }
    themeBtn.setAttribute(
      "aria-label",
      next === "dark" ? "Включить светлую тему" : "Включить тёмную тему",
    );
  });

  const menuBtn = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  function setMenu(open: boolean) {
    if (!menuBtn || !mobileNav) return;
    mobileNav.dataset.open = String(open);
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Закрыть меню" : "Открыть меню");
    document.documentElement.style.overflow = open ? "hidden" : "";
  }

  menuBtn?.addEventListener("click", () => {
    setMenu(mobileNav?.dataset.open !== "true");
  });
  mobileNav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileNav?.dataset.open === "true") {
      setMenu(false);
      menuBtn?.focus();
    }
  });

  // «/» и Cmd/Ctrl+K — быстрый переход к поиску
  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable;
    if (typing) return;
    if (event.key === "/" || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
      if (location.pathname.startsWith("/search")) return;
      event.preventDefault();
      location.href = "/search";
    }
  });
</script>
