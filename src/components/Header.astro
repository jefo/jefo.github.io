---
import { SITE } from "../config";
import Icon from "./Icon.astro";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${SITE.mark}/ — на главную`}>
      <span class="brand__plate">
        <span class="brand__name">{SITE.mark}</span><span class="brand__slash" aria-hidden="true">/</span><span class="brand__led" aria-hidden="true"></span>
      </span>
    </a>

    <div class="header-tools">
      <a href="/search" class="search-slot" aria-label="Поиск по картотеке" title="Поиск (/)">
        <Icon name="search" size={16} />
        <span class="search-slot__label">Поиск</span>
        <span class="search-slot__kbd" aria-hidden="true">/</span>
      </a>
      <span class="header-tools__divider" aria-hidden="true"></span>
      <button
        id="theme-toggle"
        class="theme-switch"
        type="button"
        aria-label="Переключить тему"
        aria-pressed="false"
        title="Бумага / сланец"
      >
        <span class="theme-switch__icon theme-switch__icon--sun"><Icon name="sun" size={13} /></span>
        <span class="theme-switch__track" aria-hidden="true"><span class="theme-switch__knob"></span></span>
        <span class="theme-switch__icon theme-switch__icon--moon"><Icon name="moon" size={13} /></span>
      </button>
      <button
        id="sidebar-toggle"
        class="icon-btn sidebar-toggle"
        type="button"
        aria-label="Открыть разделы"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        <span class="menu-icon menu-icon--open"><Icon name="menu" size={20} /></span>
        <span class="menu-icon menu-icon--close"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById("theme-toggle");

  function paintTheme(dark: boolean) {
    root.classList.toggle("dark", dark);
    root.dataset.theme = dark ? "dark" : "light";
    themeBtn?.setAttribute("aria-pressed", String(dark));
    themeBtn?.setAttribute("aria-label", dark ? "Включить светлую тему" : "Включить тёмную тему");
  }

  paintTheme(root.classList.contains("dark"));

  themeBtn?.addEventListener("click", () => {
    const next = !root.classList.contains("dark");
    paintTheme(next);
    try {
      localStorage.setItem("theme", next ? "dark" : "light");
    } catch {
      /* noop */
    }
  });

  const sidebarBtn = document.getElementById("sidebar-toggle");
  const sidebar = document.getElementById("sidebar");
  const backdrop = document.getElementById("sidebar-backdrop");

  function setSidebar(open: boolean) {
    document.body.dataset.navOpen = String(open);
    sidebarBtn?.setAttribute("aria-expanded", String(open));
    sidebarBtn?.setAttribute("aria-label", open ? "Закрыть разделы" : "Открыть разделы");
    if (backdrop) backdrop.hidden = !open;
    if (window.innerWidth <= 1000) {
      document.documentElement.style.overflow = open ? "hidden" : "";
    }
  }

  sidebarBtn?.addEventListener("click", () => {
    setSidebar(document.body.dataset.navOpen !== "true");
  });
  backdrop?.addEventListener("click", () => setSidebar(false));
  sidebar?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (window.innerWidth <= 1000) setSidebar(false);
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && document.body.dataset.navOpen === "true") setSidebar(false);
  });
  window.matchMedia("(min-width: 1001px)").addEventListener("change", (event) => {
    if (event.matches) setSidebar(false);
  });

  // «/» и Cmd/Ctrl+K — быстрый переход к поиску
  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable;
    if (typing) return;
    if (event.key === "/" || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
      if (location.pathname.startsWith("/search")) return;
      event.preventDefault();
      location.href = "/search";
    }
  });
</script>
