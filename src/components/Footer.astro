---
import { SITE, isPlaceholderLink } from "../config";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const formats = [
  { href: "/recipes", label: "Рецепты" },
  { href: "/guides", label: "Гайды" },
  { href: "/notes", label: "Заметки" },
  { href: "/tags", label: "Темы" },
];

const more = [
  { href: "/start", label: "Старт" },
  { href: "/about", label: "О картотеке" },
  { href: "/search", label: "Поиск" },
  { href: "/rss.xml", label: "RSS" },
];

const socials = [
  { href: SITE.socials.youtube, label: "YouTube", icon: "youtube" as const },
  { href: SITE.socials.telegram, label: "Telegram", icon: "telegram" as const },
  { href: SITE.socials.github, label: "GitHub", icon: "github" as const },
].filter((social) => !isPlaceholderLink(social.href));
---

<footer class="footer">
  <div class="footer__strip" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap footer__slim">
    <div class="footer__brand">
      <a href="/" class="brand" aria-label="На главную">
        <span class="brand__plate">
          <span class="brand__name">{SITE.mark}</span><span class="brand__slash" aria-hidden="true">/</span><span class="brand__led" aria-hidden="true"></span>
        </span>
      </a>
      <p class="footer__note">
        Картотека знаний об инженерии ПО с ИИ. Концепты, связи и маршруты
        вместо ленты. Миссия — {SITE.mission}.
      </p>
      <div class="footer__socials">
        {socials.map((social) => (
          <a
            href={social.href}
            class="icon-btn"
            aria-label={social.label}
            title={social.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name={social.icon} size={17} />
          </a>
        ))}
      </div>
    </div>

    <div class="footer__groups">
      <nav aria-label="Форматы">
        <p class="footer__k">Форматы</p>
        <div class="footer__inline">
          {formats.map((item) => <a href={item.href} class="footer__link">{item.label}</a>)}
        </div>
      </nav>
      <nav aria-label="Ещё">
        <p class="footer__k">Ещё</p>
        <div class="footer__inline">
          {more.map((item) => <a href={item.href} class="footer__link">{item.label}</a>)}
        </div>
      </nav>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>© {year} native/</p>
    <p>Картотека, не лента. Собрано вручную.</p>
    <a href="#content" class="footer__up">Наверх ↑</a>
  </div>
</footer>
