---
import type { Post } from "../lib/utils";
import { isoDate, postHref, readingTime, shortDate, tagColor } from "../lib/utils";
import { TYPE_META } from "../config";

interface Props {
  post: Post;
  compact?: boolean;
  lead?: boolean;
}

const { post, compact = false, lead = false } = Astro.props;
const meta = TYPE_META[post.data.type];
const href = postHref(post);
const minutes = post.data.time ?? `${readingTime(post.body)} мин`;
---

<article class:list={["entry", lead && "entry--lead"]} style={`--type-color: ${meta.color};`} data-type={post.data.type}>
  <time class="entry__date" datetime={isoDate(post.data.date)}>{shortDate(post.data.date)}</time>
  <div class="entry__body">
    <div class="entry__meta">
      <span class="entry__type">{meta.label}</span>
      <span>{minutes}</span>
    </div>
    <h2 class="entry__title"><a href={href}>{post.data.title}</a></h2>
    {!compact && <p class="entry__desc">{post.data.description}</p>}
    {!compact && post.data.tags.length > 0 && (
      <div class="entry__tags">
        {post.data.tags.slice(0, 4).map((tag) => (
          <a href={`/tags/${tag}`} style={`--tag-color: ${tagColor(tag)};`}>{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>
